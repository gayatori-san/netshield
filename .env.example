# NetShield environment variables.
# Copy to .env and edit. Every value has a safe default, so .env is optional.

# Web server bind address. Keep 127.0.0.1 unless you deliberately want LAN access.
NETSHIELD_HOST=127.0.0.1
NETSHIELD_PORT=5000

# Flask debug mode. Never enable this on a shared or exposed machine.
NETSHIELD_DEBUG=false

# Path to the SQLite database file.
NETSHIELD_DB_PATH=data/netshield.db

# Path to the detection threshold config. TOML, parsed with the stdlib.
NETSHIELD_CONFIG=config/thresholds.toml

# Maximum packets held in the processing queue before the producer waits.
NETSHIELD_QUEUE_MAXSIZE=10000

# How long the built-in synthetic demonstration scenario should run, in seconds.
NETSHIELD_DEMO_DURATION=45

# Flask session signing key. Generated at startup if unset; set a stable value
# only if you need sessions to survive a restart. This app has no login.
# NETSHIELD_SECRET_KEY=change-me-to-a-long-random-string
