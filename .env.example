# NetShield environment variables.
# Copy to .env and edit. Most values have safe defaults; Firebase is required
# before anyone can sign in.

# Web server bind address. Keep 127.0.0.1 unless you deliberately want LAN access.
NETSHIELD_HOST=127.0.0.1
NETSHIELD_PORT=5000

# Flask debug mode. Never enable this on a shared or exposed machine.
NETSHIELD_DEBUG=false

# Path to the SQLite database file.
NETSHIELD_DB_PATH=data/netshield.db

# Path to the detection threshold config. TOML, parsed with the stdlib.
NETSHIELD_CONFIG=config/thresholds.toml

# Maximum packets held in the processing queue before the producer waits.
NETSHIELD_QUEUE_MAXSIZE=10000

# How long the built-in synthetic demonstration scenario should run, in seconds.
NETSHIELD_DEMO_DURATION=45

# Flask signing key. Generated at startup if unset. Authentication itself is
# provided by Firebase; this key should still be stable for a production deploy.
# NETSHIELD_SECRET_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------- Firebase auth
# NetShield requires sign-in. Values below come from Firebase Console:
# Project settings -> Your apps -> Web app -> SDK setup and configuration.
# These six are public identifiers, not secrets, but they must match the project
# whose service account verifies tokens.
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=

# Server-side admin credentials. Choose exactly one method.
# 1) Render / containers: paste the whole service-account JSON as one value.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 2) Local file (path must be readable by the server process).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# 3) Google Application Default Credentials (gcloud auth application-default login).
# FIREBASE_USE_ADC=false

# Firebase session cookie lifetime, seconds. 300..1209600; default 432000 (5 days).
# NETSHIELD_SESSION_MAX_AGE=432000

# Cookie Secure flag: auto (HTTPS only), true, or false. Use true on Render.
# NETSHIELD_COOKIE_SECURE=auto

# Trust X-Forwarded-* headers from a reverse proxy. Enable on Render only.
# NETSHIELD_TRUST_PROXY=false

# Session-minting attempts per IP per minute. Default 30.
# NETSHIELD_AUTH_RATE_LIMIT=30
